<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests">
	<listeners>
		<listener
			class-name="HybridFrameWork.TestComponents.Listeners" />
	</listeners>
	<test thread-count="5" name="Order placement">
		<classes>
			<class name="HybridFrameWork.Tests.placeOrder" />
		</classes>
	</test> <!-- Test -->

	<test thread-count="5" name="Error validation">
		<classes>
			<class name="HybridFrameWork.Tests.errorScenarios" />
		</classes>
	</test> <!-- Test -->

</suite> <!-- Suite -->
